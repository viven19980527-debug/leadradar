# 统一换行符：云端 mac 跑 bash/xcodebuild，CRLF 会让脚本直接报「bad interpreter」
* text=auto

*.sh        text eol=lf
*.ps1       text eol=crlf
*.yaml      text eol=lf
*.yml       text eol=lf
*.swift     text eol=lf
*.pbxproj   text eol=lf
*.xcscheme  text eol=lf
*.plist     text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.py        text eol=lf

# 二进制不要碰
*.png binary
*.ipa binary
*.p8  binary
*.mobileprovision binary
